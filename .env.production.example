# Production Environment Variables for Render
# Copy to .env.production and fill in your values

# Database (Aiven MySQL)
DB_URL=jdbc:mysql://HOST:PORT/DATABASE?sslMode=REQUIRED&useSSL=true&serverTimezone=UTC
DB_USERNAME=your-username
DB_PASSWORD=your-password

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/callback

# JWT (generate: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-min-256-bits

# Groq AI
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# Frontend URL (for CORS)
FRONTEND_URL=https://yourdomain.com